# Database General Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=myproject123

# Database URLs for Docker (Internal Networks)
AUTH_DATABASE_URL=postgresql://postgres:myproject123@postgres:5432/auth_db?schema=public
APPLICATION_DATABASE_URL=postgresql://postgres:myproject123@postgres:5432/application_db?schema=public
ANALYTICS_DATABASE_URL=postgresql://postgres:myproject123@postgres:5432/analytics_db?schema=public

# Database URLs for Local Development (Outside Docker Container, mapping localhost)
LOCAL_AUTH_DATABASE_URL=postgresql://postgres:myproject123@localhost:5432/auth_db?schema=public
LOCAL_APPLICATION_DATABASE_URL=postgresql://postgres:myproject123@localhost:5432/application_db?schema=public
LOCAL_ANALYTICS_DATABASE_URL=postgresql://postgres:myproject123@localhost:5432/analytics_db?schema=public

# Redis Event Bus & Cache
REDIS_URL=redis://redis:6379
LOCAL_REDIS_URL=redis://localhost:6379

# JWT Authentication Config
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Local Uploads Directory (Docker mounts this folder)
UPLOADS_DIR=/app/uploads

# S3 File Storage (Optional - if AWS S3 is used in production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

# ── Frontend ──────────────────────────────────────────────────
# In Docker: set to your server's public IP or domain
VITE_API_BASE_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────
# In Docker: set to your frontend URL
ALLOWED_ORIGIN=http://localhost:3000
