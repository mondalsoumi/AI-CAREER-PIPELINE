{
    "manifest_version": 3,
    "name": "AI Career Pipeline",
    "version": "1.0.0",
    "description": "Save job applications to your AI Career Pipeline with one click.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:8000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "AI Career Pipeline"
    },
    "background": {
        "service_worker": "src/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/jobs/view/*",
                "https://linkedin.com/jobs/view/*"
            ],
            "js": [
                "src/content-scripts/linkedin.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://in.indeed.com/viewjob*",
                "https://www.indeed.com/viewjob*"
            ],
            "js": [
                "src/content-scripts/indeed.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://wellfound.com/jobs/*",
                "https://wellfound.com/company/*/jobs/*"
            ],
            "js": [
                "src/content-scripts/wellfound.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://instahyre.com/job-*",
                "https://www.instahyre.com/job-*"
            ],
            "js": [
                "src/content-scripts/instahyre.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}