{
    "manifest_version": 3,
    "name": "AI Career Pipeline",
    "version": "2.0.0",
    "description": "Save job applications to your AI Career Pipeline with one click.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs"
    ],
    "host_permissions": [
        "https://ai-career-api-gateway.onrender.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://wellfound.com/*",
        "https://www.wellfound.com/*",
        "https://in.indeed.com/*",
        "https://www.indeed.com/*",
        "https://instahyre.com/*",
        "https://www.instahyre.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "AI Career Pipeline"
    },
    "background": {
        "service_worker": "src/background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}