generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsSnapshot {
  id                String   @id @default(uuid())
  userId            String
  totalApplications Int
  interviewRate     Float
  offerRate         Float
  rejectionRate     Float
  sourceBreakdown   Json
  stageBreakdown    Json
  monthlyTrends     Json
  resumeBreakdown   Json
  computedAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, computedAt])
}